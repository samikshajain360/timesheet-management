# Local development example
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=timesheet_management
NEXTAUTH_SECRET=change-this-to-a-long-random-secret

# For Vercel/production, replace with your Atlas connection string.
# DO NOT put real credentials in this file. Use Vercel environment variables instead.
# Example placeholder (fill in on Vercel only):
# MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@cluster0.mongodb.net/<DB>?retryWrites=true&w=majority
